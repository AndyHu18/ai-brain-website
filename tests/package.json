{
    "name": "ai-brain-website-tests",
    "version": "1.0.0",
    "description": "AI 智能大腦公司官網 - 測試套件",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "testMatch": [
            "**/*.test.js"
        ],
        "verbose": true,
        "collectCoverageFrom": [
            "../chatbot-*.js",
            "!../node_modules/**"
        ],
        "coverageThreshold": {
            "global": {
                "statements": 80,
                "branches": 70,
                "functions": 80,
                "lines": 80
            }
        },
        "coverageReporters": [
            "text",
            "text-summary",
            "html"
        ]
    }
}